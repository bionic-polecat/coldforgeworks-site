---
import CompanyLayout from '../layouts/CompanyLayout.astro';
import StructuredData from './StructuredData.astro';
import { homepageGraph } from '../lib/site-seo.mjs';
import { backdoorWebsiteLink } from '../data/site-brand.mjs';
import { BACKDOOR_MAP_GOOGLE_PLAY_URL as googlePlayUrl } from '../data/backdoor-map';
const backdoor = backdoorWebsiteLink(import.meta.env.PUBLIC_BACKDOOR_SITE_LIVE);
---
<CompanyLayout title="Cold Forge Works LLC | BackDoor Map and reviveme.gg"
    description="The company behind BackDoor Map’s crowdsourced freight entrance map and reviveme.gg’s community for finding players and organizing games."
    canonicalUrl="https://coldforgeworks.com/">
    <StructuredData data={homepageGraph('company')} />
    <div class="company-home">
        <section class="company-intro" aria-labelledby="company-heading">
            <p class="section-label">Independent software</p>
            <h1 id="company-heading">Cold Forge Works LLC</h1>
            <p class="intro-copy">Useful tools for the places you go<br class="desktop-break" /> and the games you come back to.</p>
            <nav class="company-nav" aria-label="On this page"><a href="#backdoor-heading">BackDoor Map</a><a href="#reviveme-heading">reviveme.gg</a><a href="#contact">Contact</a></nav>
        </section>
        <section id="products" class="products" aria-labelledby="products-heading">
            <p class="section-label">What we build</p>
            <h2 id="products-heading">Two products. Practical purposes.</h2>
            <article class="product backdoor-product" aria-labelledby="backdoor-heading">
                <div class="product-copy">
                    <p class="product-status"><span class="status-dot available" aria-hidden="true"></span>Android app / Available in the U.S.</p>
                    <h3 id="backdoor-heading">BackDoor Map</h3>
                    <p class="product-intro">Find the freight entrance.<br />Before your first visit.</p>
                    <p>Find freight entrance locations other people have reported, including at buildings you’ve never visited. Submit the entrances you know and vote on reports to help improve the shared map.</p>
                    <p>Save your own freight entrance pins and private notes for next time. They’re useful even where no community report exists. Previously saved entrance information and notes stay useful offline.</p>
                    <div class="product-links"><a class="product-link" href={googlePlayUrl}>Get it on Google Play <span aria-hidden="true">&rarr;</span></a><a href={backdoor.href}>Explore BackDoor Map</a><a href="/backdoor-map/support">App support</a></div>
                    <p class="availability">Android is available on Google Play in the United States for $4.99, a one-time purchase. The iPhone version is awaiting App Store review.</p>
                    <p class="product-caution">Reported pins are not permission to enter. Follow posted signs and site rules. New searches need internet; offline map tiles are not guaranteed.</p>
                </div>
                <figure class="product-preview">
                    <img src="/backdoor-map/community-preview.webp" alt="BackDoor Map development screen with separate My entrance and Community views for the Empire State Building" width="648" height="1404" loading="lazy" />
                    <figcaption>Android development preview</figcaption>
                </figure>
            </article>
            <article class="product reviveme-product" aria-labelledby="reviveme-heading">
                <div class="product-copy">
                    <p class="product-status"><span class="status-dot available" aria-hidden="true"></span>Community website / Available now</p>
                    <h3 id="reviveme-heading">reviveme.gg</h3>
                    <p class="product-intro">Find the people.<br />Bring back the game.</p>
                    <p>A place for players to reconnect around older multiplayer games. Follow games, find other players, and organize a session through events and looking-for-group posts.</p>
                    <p>You do not need to give up on a favorite game just because its community is harder to find.</p>
                    <div class="product-links"><a class="product-link" href="https://reviveme.gg/">Visit reviveme.gg <span aria-hidden="true">&rarr;</span></a></div>
                    <p class="availability">Open the community website to browse games and upcoming sessions.</p>
                </div>
            </article>
        </section>
        <section id="company" class="company-section" aria-labelledby="about-heading">
            <p class="section-label">The company behind the products</p>
            <h2 id="about-heading">Built around everyday needs.</h2>
            <p>Cold Forge Works LLC is based in Port Washington, New York. We build and maintain our own mobile apps and community websites, focusing on information people want to find, save and use again.</p>
            <p class="internal-work">We also develop internal research tools, including ForgeScout. These are not currently public products.</p>
        </section>
        <section id="contact" class="company-section contact-section" aria-labelledby="contact-heading">
            <div><p class="section-label">Questions or support</p><h2 id="contact-heading">Get in touch.</h2></div>
            <div><a class="contact-email" href="mailto:support@coldforgeworks.com">support@coldforgeworks.com</a><p>Tell us which product you are contacting us about. Never send passwords, sign-in codes or backup recovery keys.</p><a href="/backdoor-map/support">BackDoor Map support and help</a></div>
        </section>
    </div>
</CompanyLayout>
<style>
    .company-home { overflow-wrap: anywhere; }
    .company-home :is(h1, h2, h3) { letter-spacing: 0; }
    .company-intro { padding-bottom: 48px; }
    .company-intro .section-label { margin-bottom: 16px; }
    .company-intro h1 { font-size: 2.75rem; line-height: 1.15; margin-bottom: 24px; }
    .intro-copy { font-size: 1.25rem; line-height: 1.6; color: #d9e2ec; }
    .company-nav, .product-links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; }
    .company-nav { margin-top: 24px; }
    .company-nav a, .product-links a { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; }
    .company-home a { text-underline-offset: 5px; }
    .company-home a:focus-visible { outline: 3px solid #f0d879; outline-offset: 5px; }
    .products { border-top: 1px solid #344252; padding-top: 40px; }
    .products > h2 { font-size: 1.75rem; line-height: 1.3; margin-top: 16px; }
    .product { padding-block: 40px; border-bottom: 1px solid #344252; }
    .backdoor-product { display: grid; grid-template-columns: minmax(0, 1fr) 190px; gap: 40px; align-items: start; }
    .product-status { font-size: .8rem; color: #d1dbe5; display: flex; align-items: center; gap: 8px; margin-bottom: 16px; }
    .status-dot { width: 7px; height: 7px; flex: 0 0 7px; border-radius: 50%; }
    .preparing { background: #f0d879; }
    .available { background: #91d8b1; }
    .product h3 { font-size: 2rem; line-height: 1.2; }
    .product-intro { margin-block: 20px; font-size: 1.2rem; font-weight: 550; color: #f1f5f9; }
    .product-copy > p:not(.product-status):not(.product-intro) { margin-top: 16px; color: #bdcbd8; line-height: 1.75; }
    .product-links { margin-top: 20px; }
    .product-link { font-weight: 650; text-decoration: underline; }
    .backdoor-product .product-link { color: #91d8b1; }
    .reviveme-product .product-link { color: #f0d879; }
    .product-copy .availability, .product-copy .product-caution { font-size: .8rem; }
    .product-copy .product-caution { padding-top: 16px; border-top: 1px solid #344252; }
    .product-preview { margin: 0; width: 190px; max-width: 100%; }
    .product-preview img { display: block; width: 100%; height: auto; aspect-ratio: 648 / 1404; border: 1px solid #596570; border-radius: 8px; }
    .product-preview figcaption { margin-top: 12px; font-size: .75rem; color: #bdcbd8; }
    .company-section { padding-block: 40px; border-bottom: 1px solid #344252; }
    .company-section h2 { margin-top: 16px; margin-bottom: 20px; font-size: 1.75rem; line-height: 1.3; }
    .company-section p:not(.section-label) { color: #bdcbd8; line-height: 1.75; margin-top: 16px; }
    .company-section .internal-work { font-size: .9rem; }
    .contact-section { border-bottom: 0; }
    .contact-email { font-size: 1.15rem; }
    .contact-section > div > p { margin-bottom: 16px; }
    @media (max-width: 640px) {
        .company-intro h1 { font-size: 2.125rem; }
        .desktop-break { display: none; }
        .company-nav { gap: 8px 20px; }
        .backdoor-product { grid-template-columns: minmax(0, 1fr); gap: 28px; }
        .product-preview { width: 200px; }
        .product h3 { font-size: 1.75rem; }
    }
</style>
