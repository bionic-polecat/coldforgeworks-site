---
import BackDoorSiteLayout from '../layouts/BackDoorSiteLayout.astro';
import StructuredData from './StructuredData.astro';
import { homepageGraph, PRODUCT_CANONICAL } from '../lib/site-seo.mjs';
import { BACKDOOR_MAP_PUBLICATION as publication, BACKDOOR_MAP_GOOGLE_PLAY_URL as googlePlayUrl } from '../data/backdoor-map';
const questions = [
    ['Can it help at a building I have never visited?', 'Yes, when someone has reported its freight entrance. Look up the community location and its feedback before you arrive. Coverage varies by building; an address marker alone is not a reported freight entrance. Follow current building access instructions.'],
    ['How do submissions and votes work?', 'Submit a freight entrance you know so other people can find it. Confirm a correct report, mark one wrong or suggest a correction. Votes help people assess the report; they do not guarantee accuracy or permission to enter.'],
    ['What if nobody has reported the freight entrance yet?', 'Save your own freight entrance pin and private notes for next time. Those are useful immediately, even without community coverage. Share the entrance when you choose to help the next person; your private notes are not public contributions.'],
    ['What can I use offline?', 'Previously saved places, private pins, notes and last saved community entrance information remain available on your device. New address searches, fresh community information and contributions need a connection. Offline map tiles are not guaranteed.'],
    ['Can my entrance differ from the community entrance?', 'Yes. Your personal entrance is independent of community consensus. Switch between My entrance and Community, and choose separately whether to contribute a pin or proposed correction. Your private notes are not public submissions.'],
    ['Will my places survive a lost or replaced phone?', 'Local-only information can be lost with the device or an uninstall. Optional account backup is available: enable it explicitly and check for a confirmed backup time before relying on recovery. An encrypted manual export also needs its separate recovery key.'],
    ['Does it work outside New York?', 'The Android app supports address search across the United States. Narrow the search by state, then include the city or ZIP when an address is ambiguous. Provider results and community coverage vary by location.'],
    ['Can my company share places and notes?', 'Not in the first personal-use release. Company accounts and shared workspaces are future plans. Personal notes and backup accounts are not shared with employers or coworkers.']
];
---
<BackDoorSiteLayout title="BackDoor Map | Find Freight Entrance Locations"
    description="Find crowdsourced freight entrance locations. Submit and vote on reports, and save your own freight pins and private notes. Android in the U.S."
    canonicalUrl={PRODUCT_CANONICAL}>
    <StructuredData data={homepageGraph('backdoor-map')} />
    <section class="hero" aria-labelledby="product-name">
        <img class="hero-image" src="/backdoor-map/service-entrance.webp" alt="" width="1672" height="941" fetchpriority="high" />
        <div class="site-width hero-inner">
            <p class="eyebrow">Freight entrances, shared by the people who use them</p>
            <h1 id="product-name">BackDoor Map</h1>
            <p class="hero-intro">Find the freight entrance.<br />Before your first visit.</p>
            <p class="hero-copy">Find freight entrances reported by other people—even at buildings you’ve never visited. Submit the ones you know, vote on reports, and keep your own freight entrance pins and private notes for next time.</p>
            <div class="hero-actions"><a class="button button-yellow" href={googlePlayUrl}>Get it on Google Play</a><a class="hero-link" href="#your-places">Explore the app</a><a class="hero-link" href="#release">Availability</a></div>
            <p class="hero-status">Available for Android in the U.S. · iPhone version awaiting App Store review</p>
        </div>
    </section>
    <section id="your-places" class="section site-width" aria-labelledby="personal-value">
        <div class="section-heading"><p class="eyebrow">Find it. Share it. Remember it.</p><h2 id="personal-value">Freight entrance locations.<br />Community knowledge.</h2><p>For anyone whose work takes them to a building’s freight entrance and who wants help finding it or remembering it next time.</p></div>
        <div class="features">
            <article><span class="number">01</span><h3>Find a reported freight entrance</h3><p>Look up a location someone else has reported, even before your first visit. See community feedback to help assess the report. Coverage varies by building.</p></article>
            <article><span class="number">02</span><h3>Submit an entrance. Vote on reports.</h3><p>Share a freight entrance you know. Confirm a correct report, mark one wrong or suggest a correction so the next person benefits.</p></article>
            <article><span class="number">03</span><h3>Keep your own freight pins and notes</h3><p>Save the entrance you use and the private details you want to remember. Useful from your first saved entrance, even where nobody has contributed yet.</p></article>
        </div>
        <p class="footnote">Saved information is available offline. New searches and live community updates need internet; map tiles may not be available offline.</p>
    </section>
    <section class="app-band" aria-labelledby="inside-app">
        <div class="site-width section">
            <div class="section-heading"><p class="eyebrow">A look inside</p><h2 id="inside-app">Know where the freight entrance is.</h2><p>Search for a building, see its reported freight entrance and community feedback, then save your own entrance and notes for next time.</p></div>
            <div class="screens">
                <figure><a href="/backdoor-map/search-preview.webp" aria-label="Open full-size address search preview"><img src="/backdoor-map/search-preview.webp" alt="Android development build finding 1500 Marilla Street in Dallas, Texas" width="648" height="1404" loading="lazy" /></a><figcaption><strong>Search beyond your neighborhood</strong><span>Use a state filter or add a city to narrow the address.</span></figcaption></figure>
                <figure><a href="/backdoor-map/community-preview.webp" aria-label="Open full-size community freight entrance preview"><img src="/backdoor-map/community-preview.webp" alt="Community-reported freight entrance with Confirm correct, Mark wrong and Suggest correction controls" width="648" height="1404" loading="lazy" /></a><figcaption><strong>Find what others have reported</strong><span>Use community reports and votes before your first visit. Contribute what you know to help the next person.</span></figcaption></figure>
                <figure><a href="/backdoor-map/notes-preview.webp" aria-label="Open full-size private notes preview"><img src="/backdoor-map/notes-preview.webp" alt="Private notes screen with disposable local test content" width="648" height="1404" loading="lazy" /></a><figcaption><strong>Keep the useful details with the place</strong><span>Private notes remain available with your saved building.</span></figcaption></figure>
            </div>
            <p class="footnote">Actual Android development previews with test content. Final store release screens may differ.</p>
        </div>
    </section>
    <section class="section site-width community-section" aria-labelledby="community-value">
        <div><p class="eyebrow">Someone else’s knowledge. Your first visit.</p><h2 id="community-value">Help the next person<br />find the right door.</h2></div>
        <div><p>A reported freight entrance can help someone who has never been to that building. Submit the entrances you know and vote on reports to help improve the shared map.</p><p>Your own freight entrance pin stays independent of the community pin, and your private notes are not published through contributions. You can start saving useful information even where no community report exists.</p><p>Community reports can be incomplete or outdated. Follow posted signs and current building access instructions.</p><a class="text-link" href="/backdoor-map/community-standards">Read the community standards</a></div>
    </section>
    <section id="questions" class="questions-band" aria-labelledby="questions-heading">
        <div class="site-width section questions-layout"><div><p class="eyebrow">Before you get started</p><h2 id="questions-heading">Good questions.<br />Straight answers.</h2></div><div class="questions">{questions.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div>
    </section>
    <section id="release" class="section site-width release" aria-labelledby="release-heading">
        <div><p class="eyebrow">Available on Google Play</p><h2 id="release-heading">Find it for the first visit.<br />Keep it for the next.</h2><p>The Android app is available in the United States. The iPhone version is awaiting App Store review; its release date has not been announced.</p></div>
        <div class="release-price"><p class="price">$4.99 <span>U.S. one-time price</span></p><p>One-time purchase for the personal-use Android app. Check Google Play for final availability and pricing. No subscription or unlimited cloud-storage promise.</p><a class="button button-green" href={googlePlayUrl}>Get it on Google Play</a></div>
    </section>
</BackDoorSiteLayout>
<style>
    .hero { position: relative; background: #303b3e; color: white; overflow: hidden; }
    .hero-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .hero::after { content: ''; position: absolute; inset: 0; background: #0b19192e; pointer-events: none; }
    .hero-inner { position: relative; z-index: 1; padding-block: 72px 62px; }
    .eyebrow { font-size: .875rem; font-weight: 650; margin-bottom: 16px; }
    .hero .eyebrow { color: #f5d966; }
    h1 { font-size: 4rem; font-weight: 750; margin-bottom: 20px; max-width: 650px; }
    .hero-intro { font-size: 2rem; line-height: 1.3; font-weight: 550; margin-bottom: 24px; }
    .hero-copy { max-width: 520px; font-size: 1rem; color: #f0f3f1; margin-bottom: 28px; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; }
    .button { display: inline-flex; justify-content: center; align-items: center; min-height: 48px; padding: 12px 24px; border-radius: 4px; font-size: .95rem; font-weight: 650; text-decoration: none; }
    .button-yellow { background: #f3d263; color: #253328; }
    .button-yellow:hover { background: #ffe185; color: #17231a; }
    .hero-link { color: white; font-size: .95rem; }
    .hero-link:hover { color: #f3d263; }
    .hero-status { font-size: .8rem; margin: 28px 0 0; color: #e1e7e4; }
    .section { padding-block: 72px; }
    .section-heading { max-width: 710px; margin-bottom: 40px; }
    .section-heading h2 { margin-bottom: 20px; }
    .section-heading > p:last-child { color: #51645b; max-width: 640px; }
    .features { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 40px; }
    .features article { border-top: 1px solid #b9ccbf; padding-top: 24px; }
    .number { color: #145f4c; font-size: .875rem; font-weight: 650; display: block; margin-bottom: 24px; }
    .features p { color: #51645b; margin-bottom: 0; }
    .footnote { margin: 32px 0 0; font-size: .85rem; color: #5a6a61; max-width: 760px; }
    .app-band { background: #edf3ef; border-block: 1px solid #dce6df; }
    .screens { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 48px; }
    figure { margin: 0; min-width: 0; }
    figure > a { display: block; max-width: 275px; margin-inline: auto; }
    figure img { border: 1px solid #c7d2cc; border-radius: 8px; background: #fff; width: 100%; height: auto; aspect-ratio: 648/1404; }
    figcaption { margin-top: 24px; font-size: .95rem; }
    figcaption strong, figcaption span { display: block; }
    figcaption strong { margin-bottom: 8px; }
    figcaption span { color: #51645b; }
    .community-section { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
    .community-section > div:last-child { color: #51645b; }
    .text-link { font-weight: 600; }
    .questions-band { background: #153f35; color: #fff; }
    .questions-layout { display: grid; grid-template-columns: 1fr 1.5fr; gap: 64px; }
    .questions-layout .eyebrow { color: #f3d263; }
    details { border-bottom: 1px solid #638175; }
    details:first-child { border-top: 1px solid #638175; }
    summary { cursor: pointer; padding: 22px 8px 22px 0; font-weight: 550; }
    details p { color: #e1eae4; padding-bottom: 8px; }
    .release { display: grid; grid-template-columns: 1.25fr 1fr; gap: 72px; }
    .release > div > p:not(.eyebrow):not(.price) { color: #51645b; }
    .release-price { border-left: 2px solid #d1ded5; padding-left: 40px; }
    .price { font-size: 2.5rem; line-height: 1.2; font-weight: 650; margin-bottom: 16px; }
    .price span { display: block; font-size: .875rem; font-weight: 400; margin-top: 8px; }
    .button-green { color: #fff; background: #145f4c; }
    .button-green:hover { color: #fff; background: #0c4335; }
    @media (min-width: 1600px) { .hero-inner { padding-block: 88px 76px; } }
    @media (max-width: 760px) {
        .hero-image { object-position: 30% center; }
        .hero::after { background: #0b191960; }
        .hero-inner { padding-block: 44px 40px; }
        h1 { font-size: 2.75rem; }
        .hero-intro { font-size: 1.6rem; }
        .hero-copy { max-width: 400px; }
        .desktop-break { display: none; }
        .section { padding-block: 44px; }
        .features, .community-section, .questions-layout, .release { grid-template-columns: 1fr; gap: 28px; }
        .features { gap: 24px; }
        .number { margin-bottom: 12px; }
        .screens { grid-template-columns: 1fr; gap: 40px; }
        .screens figure { max-width: 400px; margin-inline: auto; }
        figcaption { margin-top: 24px; }
        .release-price { border-left: 0; border-top: 1px solid #d1ded5; padding: 24px 0 0; }
    }
    @media (max-width: 400px) { h1 { font-size: 2.125rem; } .hero-actions { gap: 18px; } }
</style>
